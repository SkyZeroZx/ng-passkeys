# Everything has a working default for local development.
# Copy this file to .env only to change something.

PORT=3000

# The RP ID is a domain, never an origin: no scheme and no port.
# It must be the origin's host or a registrable suffix of it.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ng-passkeys

# Every origin allowed to run a ceremony, comma separated.
WEBAUTHN_ORIGIN=http://localhost:4200

# Signs the session and ceremony cookies. Required in production and on Vercel.
#   openssl rand -base64 32
SESSION_SECRET=

CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=604800

# Users and credentials. Unset: a SQLite file in .data/. Works with Neon.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ngpasskeys
# DATABASE_LOGGING=true

# Challenges and sessions. Unset: Postgres when DATABASE_URL is set, memory otherwise.
# Works with Upstash (rediss://).
# REDIS_URL=redis://localhost:6379
